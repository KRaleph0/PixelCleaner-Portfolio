# 이 파일을 .env로 복사해 값을 채운다. .env 자체는 저장소에 올리지 않는다.

DATABASE_URL=sqlite+aiosqlite:///./pixelcleaners.db
# 추후 PostgreSQL: postgresql+asyncpg://user:pass@host/db

# Cloudflare Zero Trust > Networks > Tunnels 에서 발급받은 토큰.
# 이 값을 가진 사람은 도메인으로 오는 트래픽을 자기 서버로 받아낼 수 있다. 절대 커밋하지 말 것.
CLOUDFLARE_TUNNEL_TOKEN=

# 점수 제출 인증. 구버전 클라 배포가 남아 있는 동안은 false(경고만), 이후 true.
AUTH_ENFORCE=false

# 랭킹에서 감출 device_id 접두사 (쉼표 구분). 예: demo-,claudecode-verify-
RANKING_EXCLUDE_PREFIXES=

# 납품 1개당 점수. 클라이언트 PointsPerDelivery와 반드시 동일해야 한다.
POINTS_PER_ITEM=100

# 닉네임 최대 길이 (클라 입력 제한과 동일)
DISPLAY_NAME_MAX=12

# 시간당 점수 증가분이 이 값을 넘으면 경고 로그를 남긴다 (거절하지는 않음)
SCORE_RATE_LIMIT_PER_HOUR=30000
